# ─── General ─────────────────────────────────
HEADLESS=true
SCREENSHOTS_DIR=./screenshots
PORT=3000
TAX_RATE=0

# ─── Saucedemo (default) ─────────────────────
SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# ─── ToolShop ────────────────────────────────
# Base URL for browser automation (UI)
TOOLSHOP_BASE_URL=https://practicesoftwaretesting.com

# API URL for auto-registration (REST).
# ★ The system calls POST {TOOLSHOP_API_URL}/users/register before every login
#   to ensure the account exists (DB resets every few minutes).
#   If this URL is wrong or unreachable, registration fails silently
#   and login is still attempted.
TOOLSHOP_API_URL=https://api.practicesoftwaretesting.com

# Account credentials — used for both registration and login.
# ★ Password must be wrapped in double quotes if it contains special chars (#, !, @).
TOOLSHOP_EMAIL=gohok69228@dolofan.com
TOOLSHOP_PASSWORD="gohok69228@A"
